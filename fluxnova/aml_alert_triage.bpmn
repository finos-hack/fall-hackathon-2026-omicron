<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_OmicronAML"
                  targetNamespace="https://finos.org/hackathon/omicron/aml">
  <bpmn:process id="amlAlertTriage" name="Omicron AML alert triage" isExecutable="true" camunda:historyTimeToLive="30">
    <bpmn:startEvent id="alertReceived" name="Alert received">
      <bpmn:outgoing>flowStartToPolicy</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="evaluateDeterministicPolicy"
                           name="Apply deterministic priority policy"
                           camunda:decisionRef="amlTriagePriority"
                           camunda:resultVariable="riskTier"
                           camunda:mapDecisionResult="singleEntry">
      <bpmn:incoming>flowStartToPolicy</bpmn:incoming>
      <bpmn:outgoing>flowPolicyToHuman</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:userTask id="investigatorReview"
                   name="Investigator review required"
                   camunda:candidateGroups="aml-investigators">
      <bpmn:documentation>Every alert requires an investigator disposition. The process has no automatic close or report filing path.</bpmn:documentation>
      <bpmn:incoming>flowPolicyToHuman</bpmn:incoming>
      <bpmn:outgoing>flowHumanToEnd</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="reviewRecorded" name="Human review recorded">
      <bpmn:incoming>flowHumanToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="flowStartToPolicy" sourceRef="alertReceived" targetRef="evaluateDeterministicPolicy" />
    <bpmn:sequenceFlow id="flowPolicyToHuman" sourceRef="evaluateDeterministicPolicy" targetRef="investigatorReview" />
    <bpmn:sequenceFlow id="flowHumanToEnd" sourceRef="investigatorReview" targetRef="reviewRecorded" />
  </bpmn:process>
</bpmn:definitions>
